# Supabase project connection for the public early-access capture form
# (writes to `prospect_signup` only — the anon key is safe for the browser,
# RLS restricts it to INSERT-only on that table).
#
# Get these values from the `nzonzi_database_launch` repo's own .env.example,
# or from your Supabase project dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (transactional email) -- used to send the "application confirmed"
# email after someone submits at /apply. Get an API key at resend.com,
# verify the nzonzi.net sending domain there (Resend gives you a few DNS
# records to add), then set these two. Without RESEND_API_KEY set, the
# confirmation email is silently skipped -- applications still submit
# fine, they just don't get emailed a copy.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Nzonzi <noreply@nzonzi.net>"

# Draft-reminder cron (app/api/cron/draft-reminders, scheduled once a
# day at 13:00 UTC / 9am ET in vercel.json -- Vercel Cron requires Pro
# for anything more frequent than once/day, and a faster schedule in
# vercel.json on Hobby makes Vercel reject every deploy outright, not
# just the cron) -- emails anyone who started an
# application and has been sitting on an unfinished draft for 30+
# minutes, once, ever, with their resume code and a link back to /apply.
# Same RESEND_API_KEY as above -- if it's missing or wrong in Vercel's
# project env vars (not just here), this fails the same silent way the
# confirmation email above does: the cron route itself still returns
# success, it just sends nothing. Check Resend's own logs if reminders
# seem to be going out but nobody's receiving them.
#
# SUPABASE_SERVICE_ROLE_KEY: from the Supabase dashboard -> Project
# Settings -> API -> "service_role" key (NOT the anon key above -- this
# one bypasses RLS, so keep it out of anything NEXT_PUBLIC_ and never
# expose it to the browser).
SUPABASE_SERVICE_ROLE_KEY=

# CRON_SECRET: any random string you generate yourself (e.g.
# `openssl rand -hex 32`). Set the same value here and in Vercel's
# project env vars -- Vercel Cron sends it automatically as
# "Authorization: Bearer <value>" on every scheduled hit, which is how
# the route tells a real cron run apart from a random request to the
# same URL.
CRON_SECRET=
